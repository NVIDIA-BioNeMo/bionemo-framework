@requires_cuda
def test_forward_parity(original_model, te_model, sample_batch):
    """Ported model must reproduce the original's logits and loss in bf16."""
    with torch.no_grad():
        reference = original_model(**sample_batch)
        ported = te_model(**sample_batch)

    torch.testing.assert_close(
        ported.logits.float(),
        reference.logits.float(),
        atol=GOLDEN_LOGITS_ATOL,
        rtol=GOLDEN_LOGITS_RTOL,
    )
    if getattr(reference, "loss", None) is not None:
        torch.testing.assert_close(
            ported.loss.float(), reference.loss.float(), atol=GOLDEN_LOSS_ATOL, rtol=GOLDEN_LOSS_RTOL
        )


@requires_cuda
def test_backward_runs_and_gradients_are_finite(te_model, sample_batch):
    """Backward must run and produce finite gradients for every trainable parameter."""
    outputs = te_model(**sample_batch)
    loss = outputs.loss if getattr(outputs, "loss", None) is not None else outputs.logits.float().pow(2).mean()
    loss.backward()

    unset, nonfinite = [], []
    for name, param in te_model.named_parameters():
        if not param.requires_grad:
            continue
        if param.grad is None:
            unset.append(name)
        elif not torch.isfinite(param.grad).all():
            nonfinite.append(name)

    assert not nonfinite, f"Non-finite gradients in: {nonfinite[:10]}"
    assert not unset, f"No gradient produced for: {unset[:10]}"


@requires_cuda
@pytest.mark.parametrize("quant_recipe", _parametrize_recipes())
def test_quantized_forward_and_backward(te_model, sample_batch, quant_recipe):
    """Each hardware-supported recipe must run and stay within FP8 tolerances of bf16."""
    with torch.no_grad():
        reference = te_model(**sample_batch)

    with transformer_engine.pytorch.autocast(enabled=True, recipe=quant_recipe):
        quantized = te_model(**sample_batch)
        loss = (
            quantized.loss if getattr(quantized, "loss", None) is not None else quantized.logits.float().pow(2).mean()
        )
    loss.backward()

    torch.testing.assert_close(
        quantized.logits.float(),
        reference.logits.float(),
        atol=FP8_LOGITS_ATOL,
        rtol=FP8_LOGITS_RTOL,
    )
    if getattr(reference, "loss", None) is not None:
        torch.testing.assert_close(
            quantized.loss.float(), reference.loss.float(), atol=FP8_LOSS_ATOL, rtol=FP8_LOSS_RTOL
        )


