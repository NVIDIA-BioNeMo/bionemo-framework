# The same sweep the shared harness runs ($BIONEMO_RECIPES/models/esm2/tests/common/fixtures.py::ALL_RECIPES).
# Built lazily: a missing TE symbol or unsupported constructor kwarg makes that recipe
# "unsupported" rather than crashing collection and blocking unrelated BF16 tests.
# The NVFP4 kwargs make the test deterministic -- keep them when accepted.
_RECIPE_SPECS = [
    ("DelayedScaling", {}),
    ("Float8CurrentScaling", {}),
    ("Float8BlockScaling", {}),
    ("MXFP8BlockScaling", {}),
    ("NVFP4BlockScaling", {"disable_rht": True, "disable_stochastic_rounding": True}),
]

_SUPPORT_FN_NAMES = {
    "DelayedScaling": "check_fp8_support",
    "Float8CurrentScaling": "check_fp8_support",
    "Float8BlockScaling": "check_fp8_block_scaling_support",
    "MXFP8BlockScaling": "check_mxfp8_support",
    "NVFP4BlockScaling": "check_nvfp4_support",
}


def _build_recipes():
    recipes = []
    for name, kwargs in _RECIPE_SPECS:
        cls = getattr(recipe_module, name, None)
        if cls is None:
            continue
        try:
            recipes.append(cls(**kwargs))
        except TypeError:
            # Older TE build doesn't accept these kwargs; instantiate without them.
            try:
                recipes.append(cls())
            except Exception:
                pass
    return recipes


def _build_support_checks():
    checks = {}
    for name, fn_name in _SUPPORT_FN_NAMES.items():
        fn = getattr(fp8, fn_name, None)
        if fn is not None:
            checks[name] = fn
        else:
            checks[name] = lambda _fn=fn_name: (False, f"{_fn} not present in this TE version")
    return checks


ALL_RECIPES = _build_recipes()
RECIPE_SUPPORT_CHECKS = _build_support_checks()


def _parametrize_recipes():
    """Parametrize over every recipe, xfailing (not skipping) the unsupported ones.

    Mirrors $BIONEMO_RECIPES/models/esm2/tests/common/fixtures.py::parametrize_recipes_with_support so that an
    unexpected pass on unsupported hardware stays visible.
    """
    params = []
    for recipe in ALL_RECIPES:
        name = recipe.__class__.__name__
        supported, reason = RECIPE_SUPPORT_CHECKS[name]()
        params.append(pytest.param(recipe, id=name, marks=pytest.mark.xfail(condition=not supported, reason=reason)))
    return params


requires_cuda = pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")


