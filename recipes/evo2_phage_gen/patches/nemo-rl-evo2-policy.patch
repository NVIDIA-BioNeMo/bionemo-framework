+def _apply_target_allowlist_prefixes(config: PolicyConfig) -> None:
+    """Allow extra Megatron config ``_target_`` prefixes requested by policy config."""
+    prefixes = config["megatron_cfg"].get("target_allowlist_prefixes", [])
+    if not prefixes:
+        return
+
+    from megatron.training.config.instantiate_utils import target_allowlist
+
+    for prefix in prefixes:
+        target_allowlist.add_prefix(prefix)
+
+
+class NoRefitMegatronBridge:
+    """Bridge placeholder for colocated Megatron generation paths that do not refit."""
+
+    def __init__(self, transformer_config: Any | None = None):
+        self.transformer_config = transformer_config
+
+    def get_conversion_tasks(self, *_args, **_kwargs):
+        return []
+
+    def export_hf_weights(self, *_args, **_kwargs):
+        raise NotImplementedError(
+            "Colocated Megatron generation reuses the training policy and does not export Hugging Face weights."
+        )
+
+
+def _uses_colocated_megatron_generation(config: PolicyConfig) -> bool:
+    """Return whether policy generation is Megatron and colocated with training."""
+    generation = config.get("generation") or {}
+    colocated = (generation.get("colocated") or {}).get("enabled", True)
+    return generation.get("backend") == "megatron" and colocated is not False
+
+
+def _select_megatron_bridge(config: PolicyConfig, hf_model_name: str, model):
+    """Select the default bridge or one explicit recipe-owned vLLM refit bridge."""
+    generation = config.get("generation") or {}
+    bridge_path = generation.get("refit_bridge_cls")
+    if bridge_path is not None and generation.get("backend") != "vllm":
+        raise ValueError("refit_bridge_cls is supported only for vLLM generation")
+    if _uses_colocated_megatron_generation(config):
+        return NoRefitMegatronBridge(transformer_config=getattr(model, "config", None))
+    if bridge_path is None:
+        return AutoBridge.from_hf_pretrained(hf_model_name, trust_remote_code=True)
+    if type(bridge_path) is not str:
+        raise TypeError("refit_bridge_cls must be a built-in qualified string")
+    if not bridge_path or bridge_path.strip() != bridge_path:
+        raise ValueError("refit_bridge_cls must be a non-empty qualified string")
+    module_name, separator, class_name = bridge_path.rpartition(".")
+    if not separator or not module_name or not class_name:
+        raise ValueError("refit_bridge_cls must be a qualified module.Class string")
+
+    module = importlib.import_module(module_name)
+    bridge_cls = getattr(module, class_name, None)
+    if not isinstance(bridge_cls, type):
+        raise TypeError(f"refit_bridge_cls does not resolve to a class: {bridge_path}")
+    factory = getattr(bridge_cls, "from_pretrained", None)
+    if not callable(factory):
+        raise TypeError(f"refit_bridge_cls has no callable from_pretrained: {bridge_path}")
+    bridge = factory(
+        hf_model_name,
+        transformer_config=getattr(model, "config", None),
+    )
+    for method_name in ("get_conversion_tasks", "export_hf_weights"):
+        if not callable(getattr(bridge, method_name, None)):
+            raise TypeError(f"refit bridge is missing required method {method_name}: {bridge_path}")
+    if not hasattr(bridge, "transformer_config"):
+        raise TypeError(f"refit bridge is missing transformer_config: {bridge_path}")
+    return bridge
+
