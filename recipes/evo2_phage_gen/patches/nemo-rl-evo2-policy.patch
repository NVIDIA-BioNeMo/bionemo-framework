+def _apply_target_allowlist_prefixes(config: PolicyConfig) -> None:
+    """Allow extra Megatron config ``_target_`` prefixes requested by policy config."""
+    prefixes = config["megatron_cfg"].get("target_allowlist_prefixes", [])
+    if not prefixes:
+        return
+
+    from megatron.training.config.instantiate_utils import target_allowlist
+
+    for prefix in prefixes:
+        target_allowlist.add_prefix(prefix)
+
+
+class NoRefitMegatronBridge:
+    """Bridge placeholder for colocated Megatron generation paths that do not refit."""
+
+    def __init__(self, transformer_config: Any | None = None):
+        self.transformer_config = transformer_config
+
+    def get_conversion_tasks(self, *_args, **_kwargs):
+        return []
+
+    def export_hf_weights(self, *_args, **_kwargs):
+        raise NotImplementedError(
+            "Colocated Megatron generation reuses the training policy and does not export Hugging Face weights."
+        )
+
+
+def _uses_colocated_megatron_generation(config: PolicyConfig) -> bool:
+    """Return whether policy generation is Megatron and colocated with training."""
+    generation = config.get("generation") or {}
+    colocated = (generation.get("colocated") or {}).get("enabled", True)
+    return generation.get("backend") == "megatron" and colocated is not False
+
