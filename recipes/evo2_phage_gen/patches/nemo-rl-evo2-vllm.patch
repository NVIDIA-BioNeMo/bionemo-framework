+    indices_by_group: dict[str, list[int]] = {}
+    for row_index, prompt_group_id in enumerate(prompt_group_ids):
+        indices_by_group.setdefault(prompt_group_id, []).append(row_index)
+    if any(len(indices) != prompt_group_size for indices in indices_by_group.values()):
