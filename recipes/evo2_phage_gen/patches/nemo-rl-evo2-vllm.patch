+def _stamp_repeated_rollout_ordinals(
+    repeated_batch: BatchedDataDict,
+    *,
+    num_generations_per_prompt: int,
+) -> None:
+    """Retain the original within-prompt rollout ordinal after repetition."""
+    if type(num_generations_per_prompt) is not int or num_generations_per_prompt <= 0:
+        raise TypeError("num_generations_per_prompt must be a positive built-in integer")
+    extra_env_info = repeated_batch.get("extra_env_info")
+    if extra_env_info is None:
+        return
+    if type(extra_env_info) is not list:
+        raise TypeError("extra_env_info must be a list")
+    updated = []
+    for row_index, raw_info in enumerate(extra_env_info):
+        if type(raw_info) is not dict:
+            raise TypeError("every extra_env_info row must be a built-in dictionary")
+        info = dict(raw_info)
+        if "prompt_id" not in info and "length_stratum" not in info:
+            updated.append(info)
+            continue
+        if type(info.get("prompt_id")) is not str or type(info.get("length_stratum")) is not int:
+            raise TypeError("prompt_id and length_stratum must have exact built-in types")
+        expected_ordinal = row_index % num_generations_per_prompt
+        retained_ordinal = info.get("rollout_ordinal")
+        if retained_ordinal is not None and (type(retained_ordinal) is not int or retained_ordinal != expected_ordinal):
+            raise ValueError("retained rollout ordinal conflicts with repeated-batch order")
+        info["rollout_ordinal"] = expected_ordinal
+        updated.append(info)
+    repeated_batch["extra_env_info"] = updated
+
+
+def _rollout_log_fields(
+    message_logs: list[LLMMessageLogType | VLMMessageLogType],
+    extra_env_info: list[dict[str, Any]],
+    *,
+    include_output_evidence: bool,
+) -> dict[str, list[Any]]:
+    """Build caller-identity and generation evidence fields for JSONL logging."""
+    if type(extra_env_info) is not list or len(extra_env_info) != len(message_logs):
+        raise ValueError("rollout identity rows must align with message logs")
+    fields: dict[str, list[Any]] = {}
+    for key, expected_type in _ROLLOUT_IDENTITY_TYPES.items():
+        present = [key in info for info in extra_env_info]
+        if any(present) and not all(present):
+            raise ValueError(f"rollout identity field {key} is incomplete")
+        if not any(present):
+            continue
+        values = [info[key] for info in extra_env_info]
+        if any(type(value) is not expected_type for value in values):
+            raise TypeError(f"rollout identity field {key} has an invalid type")
+        fields[key] = values
+
+    generated_by_row: list[list[dict[str, Any]]] = []
+    for message_log in message_logs:
+        generated_messages = []
+        for message in message_log:
+            if message.get("role") != "assistant" or "generation_logprobs" not in message:
+                continue
+            token_loss_mask = message.get("token_loss_mask")
+            if isinstance(token_loss_mask, torch.Tensor) and not bool(token_loss_mask.any().item()):
+                continue
+            generated_messages.append(message)
+        if not generated_messages:
+            raise ValueError("rollout message log contains no generated assistant response")
+        generated_by_row.append(generated_messages)
+
+    for key in GENERATION_REQUEST_METADATA_KEYS:
+        present = [key in message for generated_messages in generated_by_row for message in generated_messages]
+        if any(present) and not all(present):
+            raise ValueError(f"generation metadata field {key} is incomplete")
+        if any(present):
+            values = [[message[key] for message in generated_messages] for generated_messages in generated_by_row]
+            if any(type(value) is not int for row in values for value in row):
+                raise TypeError(f"generation metadata field {key} has an invalid type")
+            fields[key] = values
+
+    if include_output_evidence:
+        generated_token_ids = []
+        generated_chosen_logprobs = []
+        for generated_messages in generated_by_row:
+            row_ids = []
+            row_logprobs = []
+            for message in generated_messages:
+                token_ids = message.get("token_ids")
+                logprobs = message.get("generation_logprobs")
+                if (
+                    not isinstance(token_ids, torch.Tensor)
+                    or token_ids.ndim != 1
+                    or token_ids.dtype not in (torch.int32, torch.int64)
+                ):
+                    raise TypeError("generated token IDs must be a one-dimensional integer tensor")
+                if (
+                    not isinstance(logprobs, torch.Tensor)
+                    or logprobs.ndim != 1
+                    or not logprobs.is_floating_point()
+                    or logprobs.shape != token_ids.shape
+                    or not bool(torch.isfinite(logprobs).all().item())
+                ):
+                    raise ValueError("generated chosen logprobs must be finite and token-aligned")
+                row_ids.append(token_ids.detach().cpu().tolist())
+                row_logprobs.append(logprobs.detach().cpu().tolist())
+            generated_token_ids.append(row_ids)
+            generated_chosen_logprobs.append(row_logprobs)
+        fields["generated_token_ids"] = generated_token_ids
+        fields["generated_chosen_logprobs"] = generated_chosen_logprobs
+    return fields


