+def _request_seeds_for_dp_stream(
+    *,
+    base_seed: int,
+    call_index: int,
+    dp_rank: int,
+    dp_size: int,
+    request_count: int,
+) -> torch.Tensor:
+    """Derive one collision-free local request sequence from a physical DP stream."""
+    if min(base_seed, call_index, dp_rank, request_count) < 0 or dp_size <= 0:
+        raise ValueError("seed coordinates must be nonnegative")
+    if dp_rank >= dp_size:
+        raise ValueError("dp_rank must be smaller than dp_size")
+    if request_count > _REQUEST_SEED_ROUND_STRIDE:
+        raise ValueError("request count exceeds the collision-free stream stride")
+    stream_seed = (
+        base_seed + (call_index * dp_size + dp_rank) * _REQUEST_SEED_ROUND_STRIDE
+    ) % _REQUEST_SEED_MODULUS
+    return (
+        stream_seed + torch.arange(request_count, dtype=torch.int64)
+    ) % _REQUEST_SEED_MODULUS
