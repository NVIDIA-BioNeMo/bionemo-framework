+def generation_prompt_token_ids_bytes(token_ids: Sequence[int]) -> bytes:
+    """Encode one prompt as unambiguous, versioned, fixed-width token bytes."""
+    if type(token_ids) not in (list, tuple) or any(type(token_id) is not int for token_id in token_ids):
+        raise TypeError("prompt token IDs must be a list or tuple of built-in integers")
+    if any(not 0 <= token_id <= _GENERATION_PROMPT_TOKEN_ID_MAX for token_id in token_ids):
+        raise ValueError("prompt token IDs must be nonnegative signed-int64 values")
+    return (
+        _GENERATION_PROMPT_TOKEN_IDS_DOMAIN
+        + len(token_ids).to_bytes(8, "big")
+        + b"".join(token_id.to_bytes(8, "big") for token_id in token_ids)
+    )
+
+
+def generation_prompt_token_ids_sha256(token_ids: Sequence[int]) -> str:
+    """Hash one exact unpadded prompt token sequence."""
+    return hashlib.sha256(generation_prompt_token_ids_bytes(token_ids)).hexdigest()
