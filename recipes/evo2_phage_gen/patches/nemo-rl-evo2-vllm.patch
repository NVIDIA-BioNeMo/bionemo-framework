+@dataclass(frozen=True, slots=True)
+class VllmActorExecutionConfig:
+    """Immutable opt-in contract for the vLLM executor inside a NeMo-RL actor."""
+
+    requested_backend: str | None
+    resolved_backend: Literal["ray", "mp"]
+    async_scheduling: bool
+    fixed_gpu_count: int
+
+    @classmethod
+    def from_config(cls, config: VllmConfig) -> "VllmActorExecutionConfig":
+        vllm_kwargs = config.get("vllm_kwargs", {})
+        if not isinstance(vllm_kwargs, dict):
+            raise TypeError("vllm_kwargs must be a dictionary")
+
+        requested_backend = vllm_kwargs.get("distributed_executor_backend")
+        requested_mp = requested_backend == "mp"
+        raw_async_scheduling = vllm_kwargs.get("async_scheduling", False)
+        if requested_mp and type(requested_backend) is not str:
+            raise TypeError("distributed_executor_backend must be a built-in string")
+        if requested_mp and type(raw_async_scheduling) is not bool:
+            raise TypeError("async_scheduling must be a built-in bool for MP actors")
+        if not requested_mp:
+            return cls(
+                requested_backend=(
+                    requested_backend if type(requested_backend) is str else None
+                ),
+                resolved_backend="ray",
+                async_scheduling=(
+                    raw_async_scheduling
+                    if type(raw_async_scheduling) is bool
+                    else False
+                ),
+                fixed_gpu_count=0,
+            )
+
+        vllm_cfg = config.get("vllm_cfg")
+        if not isinstance(vllm_cfg, dict):
+            raise ValueError("TP2 MP actor requires vllm_cfg")
+        if vllm_cfg.get("tensor_parallel_size") != 2:
+            raise ValueError("TP2 MP actor requires tensor_parallel_size=2")
+        if vllm_cfg.get("pipeline_parallel_size") != 1:
+            raise ValueError("TP2 MP actor requires PP1")
+        if vllm_cfg.get("expert_parallel_size") != 1:
+            raise ValueError("TP2 MP actor does not support expert parallelism")
+        if raw_async_scheduling is not True:
+            raise ValueError("TP2 MP actor requires async_scheduling=true")
+        if vllm_cfg.get("async_engine") is not False:
+            raise ValueError("TP2 MP actor requires the outer sync NeMo-RL worker")
+        colocated = config.get("colocated")
+        if (
+            not isinstance(colocated, dict)
+            or type(colocated.get("enabled")) is not bool
+        ):
+            raise ValueError("TP2 MP actor requires an explicit colocation mode")
+
+        return cls(
+            requested_backend="mp",
+            resolved_backend="mp",
+            async_scheduling=True,
+            fixed_gpu_count=2,
+        )
