+    """Split every caller-owned prompt rollout group evenly across DP ranks."""
+    if type(dp_size) is not int or dp_size <= 0:
+        raise TypeError("generation DP size must be a positive built-in integer")
+    if type(prompt_group_size) is not int or prompt_group_size <= 0:
+        raise TypeError("prompt group size must be a positive built-in integer")
+    request_count = data.size
+    if request_count % prompt_group_size != 0:
+        raise ValueError("generation batch must contain complete prompt groups")
+    if prompt_group_size % dp_size != 0:
+        raise ValueError("each prompt rollout group must divide evenly across DP ranks")
+    prompt_group_ids = data.get("generation_prompt_group_ids")
+    if (
+        type(prompt_group_ids) is not list
+        or len(prompt_group_ids) != request_count
+        or any(type(prompt_group_id) is not str or not prompt_group_id for prompt_group_id in prompt_group_ids)
+    ):
+        raise TypeError(
+            "generation_prompt_group_ids must contain one nonempty built-in string per request"
+        )
