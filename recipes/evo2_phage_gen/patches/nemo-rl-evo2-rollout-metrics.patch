+def collect_environment_metrics(
+    batch: BatchedDataDict[DatumSpec],
+    task_to_env: dict[str, EnvironmentInterface],
+) -> dict[str, Any]:
+    """Collect optional scalar metrics from each environment's task-local rows."""
+    if not task_to_env:
+        return {}
+
+    task_names = batch["task_name"]
+    futures = []
+    future_task_names = []
+    for task_name, env in task_to_env.items():
+        metric_method = getattr(env, "global_post_process_and_metrics", None)
+        if metric_method is None:
+            continue
+        indices = [
+            index
+            for index, batch_task_name in enumerate(task_names)
+            if batch_task_name == task_name
+        ]
+        if not indices:
+            continue
+        selected_batch = batch.select_indices(torch.tensor(indices, dtype=torch.long))
+        futures.append(metric_method.remote(selected_batch))  # type: ignore[attr-defined]
+        future_task_names.append(task_name)
+
+    metrics: dict[str, Any] = {}
+    for task_name, result in zip(future_task_names, ray.get(futures), strict=True):
+        _, env_metrics = result
+        for key, value in env_metrics.items():
+            metric_key = key if key not in metrics else f"{task_name}/{key}"
+            metrics[metric_key] = value
+    return metrics
+
