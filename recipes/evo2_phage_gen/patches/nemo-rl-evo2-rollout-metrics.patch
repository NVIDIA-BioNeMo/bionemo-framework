+ENV_TIMING_METRIC_PREFIX = "__timing__/"
+
+
+def split_environment_timing_metrics(
+    metrics: dict[str, Any],
+) -> tuple[dict[str, Any], dict[str, float]]:
+    """Move environment phase timings out of ordinary rollout metrics."""
+    regular_metrics: dict[str, Any] = {}
+    timing_metrics: dict[str, float] = {}
+    for key, value in metrics.items():
+        if isinstance(key, str) and key.startswith(ENV_TIMING_METRIC_PREFIX):
+            timing_metrics[key[len(ENV_TIMING_METRIC_PREFIX) :]] = float(value)
+        else:
+            regular_metrics[key] = value
+    return regular_metrics, timing_metrics
+
+
+def _iter_display_timing_metrics(timing_metrics: dict[str, float]):
+    """Exclude absolute timestamps from the elapsed-time console summary."""
+    return (
+        (key, value)
+        for key, value in sorted(
+            timing_metrics.items(), key=lambda item: item[1], reverse=True
+        )
+        if not key.endswith("_unix_s")
+    )
+
