+def _load_generation_adapter(generation_config: dict[str, Any]) -> Any | None:
+    """Load an optional generation adapter from ``mcore_generation_config``."""
+    mcore_generation_config = generation_config.get("mcore_generation_config", {}) or {}
+    adapter_path = mcore_generation_config.get("generation_adapter")
+    if not adapter_path:
+        return None
+
+    try:
+        module_name, class_name = adapter_path.split(":", 1)
+    except ValueError as exc:
+        raise ValueError(
+            "generation_adapter must use 'module:ClassName' import-path syntax"
+        ) from exc
+
+    module = importlib.import_module(module_name)
+    adapter_cls = getattr(module, class_name)
+    adapter_config = mcore_generation_config.get("generation_adapter_config", {}) or {}
+    return adapter_cls(adapter_config)
+
+
+def _adapter_requires_all_workers(adapter: Any, generation_config: dict[str, Any]) -> bool:
+    """Return whether an adapter must run on all model-parallel workers."""
+    requires_all_workers = getattr(adapter, "requires_all_workers", False)
+    if callable(requires_all_workers):
+        return bool(requires_all_workers(generation_config))
+    return bool(requires_all_workers)
+
