+            if reference_products[i - 1] == candidate_products[j - 1]:
+                indices.add(j - 1)
+                i -= 1
+                j -= 1
+            elif dp[i - 1][j] >= dp[i][j - 1]:
+                i -= 1
+            else:
+                j -= 1
+        return indices
