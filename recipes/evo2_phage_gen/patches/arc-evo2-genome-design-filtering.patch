+    def lcs_candidate_indices(reference_products: list[str], candidate_products: list[str]) -> set[int]:
+        rows = len(reference_products)
+        cols = len(candidate_products)
+        dp = [[0] * (cols + 1) for _ in range(rows + 1)]
+        for i, reference_product in enumerate(reference_products, start=1):
